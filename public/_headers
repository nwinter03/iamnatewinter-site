# Cloudflare Pages headers — caching + baseline security

# HTML pages: always revalidate, so CMS edits show the moment the rebuild finishes (no stale cache)
/
  Cache-Control: no-cache
  Vary: Accept
  Link: </llms.txt>; rel="describedby"; type="text/plain"
  Link: </sitemap.xml>; rel="sitemap"
  Link: </agents.txt>; rel="help"; type="text/plain"
/index.html
  Cache-Control: no-cache
  Vary: Accept
  Link: </llms.txt>; rel="describedby"; type="text/plain"
  Link: </sitemap.xml>; rel="sitemap"
  Link: </agents.txt>; rel="help"; type="text/plain"
/admin/
  Cache-Control: no-cache

# Agent-discovery files: cacheable + CORS so any agent can fetch them cross-origin
/llms.txt
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600
/llms-full.txt
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600
/agents.txt
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600
/agents.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600
/.well-known/agents.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

# Hashed Astro bundles never change → cache hard
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Images + 360 frames are stable by filename
/uploads/*
  Cache-Control: public, max-age=2592000

/assets/*
  Cache-Control: public, max-age=604800

# JS loaded from fixed /scripts/ paths (not hashed) — revalidate so script updates aren't served stale
/scripts/*
  Cache-Control: no-cache

# Security headers site-wide
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()
