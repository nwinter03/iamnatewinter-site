# Cloudflare Pages headers — caching + baseline security

# HTML pages: always revalidate, so CMS edits show the moment the rebuild finishes (no stale cache)
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/admin/
  Cache-Control: no-cache

# Hashed Astro bundles never change → cache hard
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Images + 360 frames are stable by filename
/uploads/*
  Cache-Control: public, max-age=2592000

/assets/*
  Cache-Control: public, max-age=604800

# Security headers site-wide
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()
