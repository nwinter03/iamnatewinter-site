---
/*
 * Site-wide living smoke backdrop: domain-warped FBM noise drifting in
 * near-black with teal/cyan/lime forms and a soft lime cursor glow. One fixed
 * fullscreen fragment shader (raw WebGL, no library) behind ALL content, so it
 * reads as one continuous atmosphere (no container seams). Pauses on a hidden
 * tab; static CSS fallback for reduced-motion / no-WebGL. Re-themed from the
 * Auralake LiquidGradient. Rendered once in Base.astro.
 */
---
<div class="rd-backdrop" aria-hidden="true">
  <canvas class="rd-backdrop-canvas"></canvas>
  <div class="rd-backdrop-fallback"></div>
</div>

<style>
  /* fixed, full-viewport, behind everything (sits with the ambient glow) */
  .rd-backdrop { position: fixed; inset: 0; z-index: -2; overflow: hidden; pointer-events: none; }
  .rd-backdrop-canvas { width: 100%; height: 100%; display: block; opacity: 0; transition: opacity 1.2s ease; }
  .rd-backdrop.gl-on .rd-backdrop-canvas { opacity: 1; }
  /* static fallback until/unless WebGL runs */
  .rd-backdrop-fallback { position: absolute; inset: 0; opacity: 1; transition: opacity .8s ease;
    background:
      radial-gradient(60% 70% at 72% 30%, rgba(40,120,110,.16), transparent 64%),
      radial-gradient(55% 65% at 26% 78%, rgba(40,70,150,.12), transparent 64%),
      radial-gradient(45% 55% at 55% 55%, rgba(120,150,40,.08), transparent 60%); }
  .rd-backdrop.gl-on .rd-backdrop-fallback { opacity: 0; }
  @media (prefers-reduced-motion: reduce) { .rd-backdrop-canvas { display: none; } }
</style>

<script>
  const FRAG = `
  precision highp float;
  uniform float u_time; uniform vec2 u_res; uniform vec2 u_mouse;
  float hash(vec2 p){ p=fract(p*vec2(123.34,456.21)); p+=dot(p,p+45.32); return fract(p.x*p.y); }
  float noise(vec2 p){ vec2 i=floor(p), f=fract(p); f=f*f*(3.-2.*f);
    float a=hash(i), b=hash(i+vec2(1,0)), c=hash(i+vec2(0,1)), d=hash(i+vec2(1,1));
    return mix(mix(a,b,f.x),mix(c,d,f.x),f.y); }
  float fbm(vec2 p){ float v=0.,a=.5; for(int i=0;i<3;i++){ v+=a*noise(p); p*=2.03; a*=.5; } return v; }
  void main(){
    vec2 p = (gl_FragCoord.xy - .5*u_res.xy)/u_res.y;
    float t = u_time*0.035;
    vec2 q = vec2(fbm(p*1.1 + t), fbm(p*1.1 - t + 4.0));
    float n = fbm(p*1.1 + q*1.6 + t*0.7);
    n = smoothstep(0.22, 0.96, n);
    vec2 m = (u_mouse - 0.5*u_res.xy)/u_res.y;
    float md = exp(-dot(p-m,p-m)*2.6);
    vec3 base = vec3(0.035, 0.036, 0.040);
    vec3 cool1 = vec3(0.05, 0.14, 0.16);          /* muted teal */
    vec3 cool2 = vec3(0.04, 0.07, 0.17);          /* deep blue */
    vec3 tint = mix(cool1, cool2, smoothstep(0.45, 1.0, n));
    vec3 col = base + tint * n * 0.9;             /* subtle cool drift, no rainbow */
    col += vec3(0.847, 1.0, 0.227) * md * 0.12 * (0.5 + 0.5*n);  /* lime = cursor glow only */
    float vig = smoothstep(1.34, 0.30, length(p*vec2(0.82, 1.0)));
    col *= mix(0.80, 1.0, vig);                    /* sink the far edges into black */
    gl_FragColor = vec4(col, 1.0);
  }`;
  const VERT = `attribute vec2 a; void main(){ gl_Position = vec4(a,0.,1.); }`;

  function init(root) {
    const canvas = root.querySelector('.rd-backdrop-canvas');
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const gl = canvas.getContext('webgl', { antialias: false, alpha: false, powerPreference: 'low-power' });
    if (!gl) return; // keep the CSS fallback

    const sh = (type, src) => { const s = gl.createShader(type); gl.shaderSource(s, src); gl.compileShader(s); return s; };
    const prog = gl.createProgram();
    gl.attachShader(prog, sh(gl.VERTEX_SHADER, VERT));
    gl.attachShader(prog, sh(gl.FRAGMENT_SHADER, FRAG));
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return;
    gl.useProgram(prog);

    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1,-1, 3,-1, -1,3]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, 'a');
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

    const uTime = gl.getUniformLocation(prog, 'u_time');
    const uRes = gl.getUniformLocation(prog, 'u_res');
    const uMouse = gl.getUniformLocation(prog, 'u_mouse');

    const dpr = Math.min(devicePixelRatio || 1, 1.25);
    let w = 0, h = 0;
    const mouse = { x: 0, y: 0, tx: 0, ty: 0 };
    function resize() {
      w = Math.max(1, Math.round(innerWidth * dpr)); h = Math.max(1, Math.round(innerHeight * dpr));
      canvas.width = w; canvas.height = h;
      gl.viewport(0, 0, w, h);
      if (!mouse.x) { mouse.x = mouse.tx = w * 0.72; mouse.y = mouse.ty = h * 0.6; }
    }
    resize();
    addEventListener('resize', resize, { passive: true });
    addEventListener('pointermove', (e) => {
      mouse.tx = e.clientX * dpr;
      mouse.ty = (innerHeight - e.clientY) * dpr; // flip y for GL
    }, { passive: true });

    root.classList.add('gl-on');

    let raf = 0, start = performance.now(), last = 0;
    function loop() {
      cancelAnimationFrame(raf);
      const frame = (now) => {
        if (!document.hidden) raf = requestAnimationFrame(frame);
        if (now - last < 28) return;   // cap ~36fps — ample for a slow drift, ~half the GPU
        last = now;
        mouse.x += (mouse.tx - mouse.x) * 0.07;
        mouse.y += (mouse.ty - mouse.y) * 0.07;
        gl.uniform1f(uTime, (now - start) / 1000);
        gl.uniform2f(uRes, w, h);
        gl.uniform2f(uMouse, mouse.x, mouse.y);
        gl.drawArrays(gl.TRIANGLES, 0, 3);
      };
      raf = requestAnimationFrame(frame);
    }
    document.addEventListener('visibilitychange', () => { if (!document.hidden) loop(); });
    loop();
  }

  document.querySelectorAll('.rd-backdrop').forEach(init);
</script>
