      </svg>
    </a>
    <nav class="site-nav" aria-label="Primary">
      {primaryLinks.map(([href, label]) => <a href={href}>{label}</a>)}
      <a href="#contact" class="nav-cta">Start a project</a>
    </nav>
    <button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
      <span class="menu-bar"></span>
      <span class="menu-bar"></span>
    </button>
  </header>

  <!-- MOBILE MENU -->
  <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <nav class="mobile-nav" aria-label="Mobile">
      {primaryLinks.map(([href, label]) => <a href={href}><span>{label}</span></a>)}
      <a href="#contact" class="mobile-cta"><span>Start a project</span></a>
    </nav>
    <div class="mobile-menu-foot">
      <a href="mailto:me@iamnatewinter.com">me@iamnatewinter.com</a>
      <div class="mobile-socials">
        <a href="https://www.instagram.com/iamnatewinter/" target="_blank" rel="noopener">Instagram</a>
        <a href="https://www.linkedin.com/in/natewinterdesign/" target="_blank" rel="noopener">LinkedIn</a>
      </div>
    </div>
  </div>

  <main id="top">
    <slot />
  </main>

  <footer class="site-footer">
    <a class="qmark" href="#top" aria-label="Back to top">
      <svg class="qmark-svg" viewBox="0 0 110.81 350.47" aria-hidden="true" focusable="false">
        <path class="qmark-hook" d="M100.08,97.14c4.87-22.95,7.31-41.49,7.31-51.25C107.39,14.15,88.85,0,57.61,0,31.74,0,14.65,12.2,0,34.16l10.75,7.81c12.2-16.1,20.01-22.93,30.27-22.93,8.78,0,13.65,3.9,13.65,16.1,0,5.86-.97,13.2-2.92,21.98-1.47,9.26-31.24,155.7-37.1,181.58h93.72l2.44-12.7h-39.05c4.39-18.54,22.46-102.5,28.32-128.85Z"/>
        <path class="qmark-dot" d="M40.52,283.6c-24.9,0-40.52,16.1-40.52,38.55,0,20.01,12.7,28.32,31.24,28.32,24.9,0,40.52-17.09,40.52-38.57,0-15.62-7.81-28.3-31.24-28.3Z"/>
      </svg>
    </a>
    <nav class="footer-nav" aria-label="Footer">
      {footerLinks.map(([href, label]) => <a href={href}>{label}</a>)}
    </nav>
    <div class="footer-base rd-foot-base">
      <span class="rd-foot-copy">© 2026 Nate Winter. Made in Milwaukee.</span>
      <div class="rd-foot-social">
        <a href={contact.instagram} target="_blank" rel="noopener">Instagram</a>
        <a href={contact.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      </div>
    </div>
  </footer>

  <!-- LIGHTBOX -->
  <div class="lightbox" aria-hidden="true" role="dialog" aria-label="Project view">
    <button class="lightbox-close" type="button" aria-label="Close">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round"/></svg>
    </button>
    <button class="lightbox-nav lightbox-prev" type="button" aria-label="Previous project">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <button class="lightbox-nav lightbox-next" type="button" aria-label="Next project">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <div class="lightbox-stage"></div>
    <div class="lightbox-info">
      <h3 class="lightbox-title"></h3>
      <span class="lightbox-cat"></span>
    </div>
  </div>

  <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>
  <script is:inline src="/scripts/main.js"></script>
  <script is:inline src="/scripts/motion.js"></script>
</body>
</html>
