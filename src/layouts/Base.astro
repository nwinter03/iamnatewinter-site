---
import site from '../data/site.json';
const { hero, contact } = site;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Nate Winter — 3D Motion Designer for Product Visualization · Brand &amp; Packaging</title>
  <meta name="description" content="3D motion designer specializing in cinematic product visualization for CPG and supplement brands. Also: brand systems, packaging design, and art direction. Milwaukee, WI." />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600&family=Syne:wght@400;500;600&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/styles/base.css" />
  <link rel="stylesheet" href="/styles/layout.css" />
  <link rel="stylesheet" href="/styles/motion.css" />

  <script src="https://cdn.jsdelivr.net/npm/lenis@1.1.20/dist/lenis.min.js" defer></script>
</head>
<body>
  <div class="page-loader" aria-hidden="true">
    <img src="/assets/logo.svg" alt="" class="loader-logo" />
  </div>

  <div class="grain" aria-hidden="true"></div>
  <div class="cursor" aria-hidden="true"></div>
  <div class="cursor-dot" aria-hidden="true"></div>

  <header class="site-header">
    <a href="#top" class="brand" aria-label="Nate Winter — Home">
      <img src="/assets/logo.svg" alt="Nate Winter" class="brand-logo" />
    </a>
    <nav class="site-nav" aria-label="Primary">
      <a href="#work">Work</a>
      <a href="#process">Process</a>
      <a href="#about">About</a>
      <a href="#services">Services</a>
      <a href="#contact" class="nav-cta">Start a project</a>
    </nav>
  </header>

  <main id="top">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="footer-grid">
      <div class="foot-brand">
        <img src="/assets/logo.svg" alt="Nate Winter" class="brand-logo brand-logo-sm" />
        <span>© 2026 Nate Winter. Made in Milwaukee.</span>
      </div>
      <nav aria-label="Footer">
        <a href="#work">Work</a>
        <a href="#process">Process</a>
        <a href="#about">About</a>
        <a href="#services">Services</a>
        <a href="#contact">Contact</a>
      </nav>
    </div>
  </footer>

  <!-- PICTURE-IN-PICTURE REEL -->
  <div class="pip-reel" aria-hidden="true" data-vimeo={hero.reelVimeoId}>
    <div class="pip-mount"></div>
    <span class="pip-label">Reel</span>
    <button class="pip-close" type="button" aria-label="Dismiss reel">
      <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round"/></svg>
    </button>
  </div>

  <!-- LIGHTBOX -->
  <div class="lightbox" aria-hidden="true" role="dialog" aria-label="Project view">
    <button class="lightbox-close" type="button" aria-label="Close">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round"/></svg>
    </button>
    <button class="lightbox-nav lightbox-prev" type="button" aria-label="Previous project">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <button class="lightbox-nav lightbox-next" type="button" aria-label="Next project">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <div class="lightbox-stage"></div>
    <div class="lightbox-info">
      <h3 class="lightbox-title"></h3>
      <span class="lightbox-cat"></span>
    </div>
  </div>

  <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>
  <script is:inline src="/scripts/main.js"></script>
  <script is:inline src="/scripts/motion.js"></script>
</body>
</html>
