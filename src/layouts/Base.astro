        <path d="M608.98,277.26l-10.25-7.81c-10.73,15.62-20.49,21.96-29.27,21.96-9.78,0-14.17-4.87-14.17-17.07,0-3.42,0-7.81.99-12.7,8.78-62.48,22.93-132.29,35.13-192.33-16.12,2.44-36.13,3.91-53.2,3.42l-8.31,31.74c-11.23-24.4-29.29-37.6-59.56-37.6-81.02,0-120.07,86.41-120.07,156.7,0,55.17,23.93,86.88,71.76,86.88s73.21-31.24,88.35-65.4l2.42.48c-2.42,9.28-3.9,17.59-3.9,25.4,0,23.91,13.18,39.53,45.39,39.53,24.9,0,42.96-14.65,54.67-33.19ZM441.55,289.47c-28.3,0-33.68-23.93-33.68-59.06,0-77.13,21.48-147.42,71.28-147.42,25.85,0,41,20.01,41,63.45,0,67.37-34.18,143.02-78.6,143.02Z"/>
