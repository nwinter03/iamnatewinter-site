---
// Global stylesheets imported (not <link>ed) so Astro hashes them.
// Hashed URLs change on every edit, so CSS changes are never served stale.
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/motion.css';
import LiquidBackdrop from '../components/LiquidBackdrop.astro';
import site from '../data/site.json';
const { hero, contact } = site;

// Nav menu (Work · Services · About + the "Start a project" CTA).
const primaryLinks = [['#work', 'Work'], ['#services', 'What I do'], ['#about', 'About']];
const footerLinks = [['#work', 'Work'], ['#services', 'What I do'], ['#about', 'About'], ['#contact', 'Contact']];

const siteUrl = (Astro.site?.href || 'https://iamnatewinter.com/').replace(/\/$/, '');
const pageTitle = site.seo?.title || 'Nate Winter · Designer · 3D Product Visualization & Motion';
const pageDesc = site.seo?.description || 'Milwaukee designer and creative director specializing in 3D product visualization, motion, and packaging for CPG, supplement, beauty, and wellness brands.';
const ogImage = `${siteUrl}/uploads/2024/02/hero.jpg`;
const canonical = `${siteUrl}/`;
const ogImageAlt = 'Nate Winter, 3D product visualization still';
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteUrl}/#nate`,
      name: 'Nate Winter',
      jobTitle: 'Designer & Creative Director',
      url: `${siteUrl}/`,
      image: ogImage,
      description: pageDesc,
      address: { '@type': 'PostalAddress', addressLocality: 'Milwaukee', addressRegion: 'WI', addressCountry: 'US' },
      knowsAbout: ['3D Product Visualization', 'Product Animation', 'Motion Design', 'Packaging Design', 'Brand Identity', 'Creative Direction'],
      sameAs: [contact.instagram, contact.linkedin].filter(Boolean),
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: `${siteUrl}/`,
      name: 'Nate Winter',
      description: pageDesc,
      publisher: { '@id': `${siteUrl}/#nate` },
      inLanguage: 'en-US',
    },
  ],
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc} />
  <meta name="author" content="Nate Winter" />
  <link rel="canonical" href={canonical} />
  <meta name="theme-color" content="#0b0b0c" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <!-- Open Graph (link previews: iMessage, LinkedIn, Slack, Facebook) -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Nate Winter" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDesc} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1920" />
  <meta property="og:image:height" content="1080" />
  <meta property="og:image:alt" content={ogImageAlt} />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDesc} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={ogImageAlt} />

  <script type="application/ld+json" set:html={JSON.stringify(ld)}></script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600&family=Syne:wght@400;500;600&display=swap" rel="stylesheet">

  <!-- Global CSS is imported in the frontmatter so Astro emits hashed, cache-busted bundles. -->

  <script src="https://cdn.jsdelivr.net/npm/lenis@1.1.20/dist/lenis.min.js" defer></script>
</head>
<body>
  <LiquidBackdrop />

  <div class="page-loader" aria-hidden="true">
    <video class="loader-video" autoplay muted playsinline preload="auto">
      <source src="/assets/intro.mp4" type="video/mp4" />
    </video>
  </div>

  <div class="ambient-glow" aria-hidden="true">
    <span class="glow-blob glow-1"></span>
    <span class="glow-blob glow-2"></span>
    <span class="glow-blob glow-3"></span>
  </div>

  <div class="grain" aria-hidden="true"></div>
  <div class="cursor" aria-hidden="true"><span class="cursor-cue"></span></div>
  <div class="cursor-dot" aria-hidden="true"></div>

  <header class="site-header">
    <a href="#top" class="brand" aria-label="Nate Winter, Home">
