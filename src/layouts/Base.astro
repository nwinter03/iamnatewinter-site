        <path d="M1090,482.6c41.49-7.81,91.77-23.43,91.77-73.71,0-36.61-25.4-56.12-68.84-56.12-79.55,0-133.74,68.82-133.74,151.79,0,57.61,30.76,91.77,87.86,91.77s92.27-27.82,108.37-82.49l-13.18-3.9c-17.57,51.25-47.83,66.37-75.66,66.37-34.66,0-48.33-21.48-48.33-81.02v-6.84c17.59-.97,35.15-2.94,51.75-5.86ZM1105.12,365.95c16.61,0,25.87,11.7,25.87,36.11,0,51.75-38.55,68.84-91.77,72.26,7.81-68.34,37.1-108.37,65.9-108.37Z"/>
