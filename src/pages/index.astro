---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import { getCollection } from 'astro:content';

const { hero, marquee, marqueeLabel, about, services, contact } = site;

// Load category galleries and flatten their items into cards.
const galleries = await getCollection('galleries');
const byCat = {};
for (const g of galleries) {
  byCat[g.data.category] = g.data.items.map((it) => ({ ...it, category: g.data.category }));
}
// Round-robin interleave across categories so the "All" view reads as a mix.
const catOrder = ['animation', 'stills', 'motion', 'packaging', 'branding', 'artwork'];
const projects = [];
let ri = 0, addedAny = true;
while (addedAny) {
  addedAny = false;
  for (const cat of catOrder) {
    const arr = byCat[cat] || [];
    if (ri < arr.length) { projects.push({ data: arr[ri] }); addedAny = true; }
  }
  ri++;
}

const catLabels = {
  animation: 'Product Animation',
  stills: 'Product Stills',
  motion: 'Motion Graphics',
  packaging: 'Packaging · 360°',
  branding: 'Logo / Branding',
  artwork: 'Artwork',
};

// Group services by their "group" field
const serviceGroups = services.reduce((acc, s) => {
  (acc[s.group] ??= []).push(s);
  return acc;
}, {});

const processSteps = [
  { num: '01 · Direction',
    body: "We define the product, the audience, and the look before anything gets made. You leave with a clear creative direction, scope, price, and timeline, no guessing." },
  { num: '02 · Build',
    body: "I build the product world, the 3D, motion, packaging, and campaign frames the brief calls for, art-directed as one cohesive system with feedback at every beat." },
  { num: '03 · Delivery',
    body: "Launch-ready files for web, social, ads, PDPs, and decks. Every deliverable plus the source, a clean handoff with no retainers or surprises." },
];
---
<Base>
  <!-- HERO -->
  <section class="hero" aria-label="Intro">
    <div class="hero-meta">
      <span class="eyebrow">{hero.eyebrow}</span>
    </div>
    <h1 class="hero-title">
      <span class="line"><span class="reveal">{hero.line1}</span></span>
      <span class="line"><span class="reveal">{hero.line2}</span></span>
      <span class="line italic"><span class="reveal">{hero.line3}</span></span>
      <span class="line italic"><span class="reveal">{hero.line4}</span></span>
    </h1>
    <div class="hero-foot">
      <p class="hero-sub" set:html={hero.subtext}></p>
      <div class="hero-cta">
        <a href="#work" class="btn">View the work</a>
        <a href="#contact" class="hero-cta-link">Start a project →</a>
      </div>
    </div>
    <div class="hero-reel">
      <button class="reel-frame reel-trigger" type="button" data-vimeo={hero.reelVimeoId}
              aria-label="Watch the demo reel with sound">
        <iframe class="reel-bg" tabindex="-1" aria-hidden="true"
          src={`https://player.vimeo.com/video/${hero.reelVimeoId}?background=1&autoplay=1&loop=1&muted=1&dnt=1`}
          frameborder="0" allow="autoplay; fullscreen" loading="lazy"></iframe>
        <div class="reel-overlay">
          <span class="reel-label">Demo Reel · {hero.reelDuration}</span>
          <span class="reel-watch">
            <svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
            Watch with sound
          </span>
        </div>
      </button>
    </div>
  </section>

  <!-- MARQUEE -->
  <section class="marquee-wrap" aria-label="Sectors">
    <div class="marquee">
      <div class="marquee-track">
        {marqueeLabel && <><span>{marqueeLabel}</span><span class="dot">●</span></>}
        {marquee.map((m) => (<><span>{m}</span><span class="dot">●</span></>))}
        {marqueeLabel && <><span>{marqueeLabel}</span><span class="dot">●</span></>}
        {marquee.map((m) => (<><span>{m}</span><span class="dot">●</span></>))}
      </div>
    </div>
  </section>

  <!-- WORK GRID -->
  <section class="section work" id="work" aria-label="Selected work">
    <header class="section-head">
      <span class="section-num">Work</span>
      <h2 class="section-title">Made for clients,<br /><span class="italic">and for the craft.</span></h2>
    </header>
    <div class="filters" role="tablist" aria-label="Filter work">
      <button class="filter is-active" data-filter="all" role="tab" aria-selected="true">All</button>
      <button class="filter" data-filter="animation" role="tab">Product Animation</button>
      <button class="filter" data-filter="stills" role="tab">Product Stills</button>
      <button class="filter" data-filter="motion" role="tab">Motion Graphics</button>
      <button class="filter" data-filter="packaging" role="tab">Packaging Design</button>
      <button class="filter" data-filter="branding" role="tab">Logo / Branding</button>
      <button class="filter" data-filter="artwork" role="tab">Artwork</button>
    </div>
    <div class="work-grid">
      {projects.map((p) => {
        const d = p.data;
        const spinAttrs = d.spinPrefix
          ? { 'data-spin-folder': d.spinFolder, 'data-spin-prefix': d.spinPrefix, 'data-spin-count': d.spinCount }
          : {};
        const videoAttr = d.video ? { 'data-video': d.video } : {};
        return (
          <a class="work-card" href="#" data-cat={d.category} data-aspect="square" {...videoAttr} {...spinAttrs}>
            <div class="work-thumb" data-swatch={d.swatch}>
              <img src={d.image} alt={d.title} loading="lazy" onerror="this.style.display='none'" />
              {d.video && <video class="work-video" muted loop playsinline preload="none"></video>}
              <div class="work-meta">
                <h3>{d.title}</h3>
                <span class="work-cat">{catLabels[d.category]}</span>
              </div>
            </div>
          </a>
        );
      })}
    </div>
    <nav class="work-pagination" aria-label="Work pages"></nav>
  </section>

  <!-- PROCESS -->
  <section class="section process" id="process" aria-label="Process">
    <header class="section-head">
      <span class="section-num">Process</span>
      <h2 class="section-title">How I work, <span class="italic">end to end.</span></h2>
    </header>
    <div class="process-steps">
      {processSteps.map((s) => (
        <article class="process-step">
          <span class="process-num">{s.num}</span>
          <p>{s.body}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- ABOUT -->
  <section class="section about" id="about" aria-label="About">
    <header class="section-head">
      <span class="section-num">{about.eyebrow}</span>
      <h2 class="section-title">Strong creative direction, <span class="italic">rendered honestly.</span></h2>
    </header>
    <div class="about-grid">
      <div class="about-portrait">
        {about.portraitVideo
          ? <Fragment>
              <video class="about-src" src={about.portraitVideo} poster={about.portrait || undefined}
                     autoplay muted loop playsinline preload="auto" aria-label="Nate Winter sketching"></video>
              <canvas class="about-stopmo" aria-hidden="true"></canvas>
              <span class="about-grain" aria-hidden="true"></span>
            </Fragment>
          : (about.portrait && <img src={about.portrait} alt="Nate Winter" loading="lazy" onerror="this.style.display='none'" />)}
      </div>
      <div class="about-copy">
        <p class="lead">{about.lead}</p>
        {about.body.map((para) => <p>{para}</p>)}
        <a href="#contact" class="btn">Start a project →</a>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section services" id="services" aria-label="Services">
    <header class="section-head">
      <span class="section-num">Services</span>
      <h2 class="section-title">What I make.</h2>
    </header>
    {Object.entries(serviceGroups).map(([group, items]) => (
      <div class="services-group">
        <h3 class="group-title">{group}</h3>
        <ul class="services-list">
          {items.map((s) => (
            <li class="service">
              <span class="svc-num">{s.num}</span>
              <div>
                <h3>{s.title}</h3>
                <p>{s.desc}</p>
              </div>
              <span class="svc-tag">{s.tag}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>

  <!-- CONTACT -->
  <section class="section contact" id="contact" aria-label="Contact">
    <header class="section-head">
      <span class="section-num">{contact.eyebrow}</span>
      <h2 class="section-title">Have a product that needs a stronger visual world? <span class="italic">Let's talk.</span></h2>
    </header>
    <div class="contact-grid">
      <div class="contact-copy">
        <p class="lead">{contact.lead}</p>
        <ul class="contact-expect">
          {contact.expect.map((e, i) => (<li><span>{i + 1}.</span> {e}</li>))}
        </ul>
        <div class="contact-direct">
          <a href={`mailto:${contact.email}`}>{contact.email}</a>
          <div class="socials">
            <a href={contact.instagram} target="_blank" rel="noopener">Instagram</a>
            <a href={contact.linkedin} target="_blank" rel="noopener">LinkedIn</a>
          </div>
        </div>
      </div>
      <form class="contact-form" onsubmit="event.preventDefault(); this.querySelector('.form-success').hidden = false;">
        <label><span>Your name</span><input type="text" name="name" required /></label>
        <label><span>Email</span><input type="email" name="email" required /></label>
        <label><span>Brand / company</span><input type="text" name="brand" /></label>
        <label><span>Project type</span>
          <select name="type">
            <option>Product animation</option>
            <option>Product stills</option>
            <option>Brand &amp; packaging design</option>
            <option>Creative direction &amp; consulting</option>
            <option>Not sure yet</option>
          </select>
        </label>
        <label class="full"><span>Tell me about the project</span><textarea name="message" rows="4" required></textarea></label>
        <button type="submit" class="btn btn-primary">Send →</button>
        <p class="form-success" hidden>Thanks, I'll be in touch shortly.</p>
      </form>
    </div>
  </section>
</Base>
