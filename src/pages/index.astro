---
// Homepage. Hero (reel) → Marquee → Work (filterable) → Services → About → Contact.
// All copy is editable in the CMS (src/data/site.json); the filterable work grid +
// marquee reuse the live class names so main.js wires up filtering, hover-play,
// 360° spin, pagination, and the lightbox automatically.
import Base from '../layouts/Base.astro';
import '../styles/redesign.css';
import site from '../data/site.json';
import { getCollection } from 'astro:content';
import { createMarkdownProcessor } from '@astrojs/markdown-remark';

const { hero, work, services, about, contact, marquee, marqueeLabel } = site;

// Section headings: wrap the italic phrase in *asterisks* in the CMS → two-tone accent.
const escapeHtml = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const sectionTitle = (s) => escapeHtml(s || '')
  .replace(/\r?\n/g, '<br>')
  .replace(/\*([^*]+)\*/g, '<span class="italic">$1</span>');

// About body is rich text (markdown) from the CMS → render it to HTML.
const mdProcessor = await createMarkdownProcessor({ smartypants: false });
const aboutBodyHtml = (await mdProcessor.render(about.body || '')).code;

// Load category galleries and flatten their items into cards.
const galleries = await getCollection('galleries');
const byCat = {};
for (const g of galleries) {
  let items = g.data.items.map((it) => ({ ...it, category: g.data.category }));
  if (g.data.order === 'random') {
    for (let i = items.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [items[i], items[j]] = [items[j], items[i]];
    }
  }
  byCat[g.data.category] = items;
}
const catOrder = ['animation', 'stills', 'motion', 'packaging', 'branding', 'artwork'];
const projects = [];
let ri = 0, addedAny = true;
while (addedAny) {
  addedAny = false;
  for (const cat of catOrder) {
    const arr = byCat[cat] || [];
    if (ri < arr.length) { projects.push({ data: arr[ri] }); addedAny = true; }
  }
  ri++;
}
const catLabels = {
  animation: 'Product Animation',
  stills: 'Product Stills',
  motion: 'Motion Graphics',
  packaging: 'Packaging · 360°',
  branding: 'Logo / Branding',
  artwork: 'Artwork',
};

// Service-card icon family (24-grid, 1.5 stroke). The CMS picks one by key.
const sw = 'fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"';
const icons = {
  target:  `<svg viewBox="0 0 24 24" ${sw}><circle cx="12" cy="12" r="8.25"/><circle cx="12" cy="12" r="3.75"/></svg>`,
  box:     `<svg viewBox="0 0 24 24" ${sw}><path d="M12 3.5 4 7.75v8.5L12 20.5l8-4.25v-8.5Z"/><path d="M4.2 7.9 12 12l7.8-4.1"/><path d="M12 12v8.4"/></svg>`,
  image:   `<svg viewBox="0 0 24 24" ${sw}><rect x="3.5" y="4.75" width="17" height="14.5" rx="2.5"/><circle cx="8.5" cy="9.75" r="1.5"/><path d="M19.5 15 15 10.5 7 18.5"/></svg>`,
  play:    `<svg viewBox="0 0 24 24" ${sw}><circle cx="12" cy="12" r="8.25"/><path d="M10.25 8.5 15.5 12l-5.25 3.5Z"/></svg>`,
  sparkle: `<svg viewBox="0 0 24 24" ${sw}><path d="M12 4C12.6 9.4 14.6 11.4 20 12 14.6 12.6 12.6 14.6 12 20 11.4 14.6 9.4 12.6 4 12 9.4 11.4 11.4 9.4 12 4Z"/></svg>`,
  window:  `<svg viewBox="0 0 24 24" ${sw}><rect x="3.5" y="4.75" width="17" height="14.5" rx="2.5"/><path d="M3.5 9.25h17"/></svg>`,
  cart:    `<svg viewBox="0 0 24 24" ${sw}><path d="M6 8.25h12l-1 11.25H7Z"/><path d="M9 8.25V6.5a3 3 0 0 1 6 0v1.75"/></svg>`,
  chat:    `<svg viewBox="0 0 24 24" ${sw}><path d="M19.5 11.75a7.25 7.25 0 0 1-10.2 6.6L4.5 19.5l1.15-4.8A7.25 7.25 0 1 1 19.5 11.75Z"/></svg>`,
  sphere:  `<svg viewBox="0 0 24 24" ${sw}><circle cx="12" cy="12" r="8.25"/><path d="M3.75 12h16.5M12 3.75c2.75 3.2 2.75 13.3 0 16.5M12 3.75c-2.75 3.2-2.75 13.3 0 16.5"/></svg>`,
};
---
<Base>
  <!-- HERO -->
  <section class="rd-hero" aria-label="Intro">
    <div class="rd-hero-text">
      <p class="rd-eyebrow">{hero.eyebrow}</p>
      <h1 class="rd-hero-title" set:html={sectionTitle(hero.headline)}></h1>
      <p class="rd-hero-intro">{hero.intro}</p>
      <div class="rd-hero-cta">
        <a href="#work" class="rd-link-arrow">{hero.ctaLabel}<span class="rd-arrow">→</span></a>
      </div>
    </div>
    <div class="rd-hero-media">
      <button class="rd-reel reel-trigger" type="button" data-vimeo={hero.reelVimeoId} aria-label="Watch the demo reel">
        <div class="rd-reel-chrome rd-reel-chrome-top" aria-hidden="true"></div>
        <div class="rd-reel-screen">
          <iframe class="rd-reel-bg" tabindex="-1" aria-hidden="true" title="Nate Winter demo reel"
            src={`https://player.vimeo.com/video/${hero.reelVimeoId}?background=1&autoplay=1&loop=1&muted=1&dnt=1`}
            frameborder="0" allow="autoplay; fullscreen" loading="lazy"></iframe>
        </div>
        <div class="rd-reel-chrome rd-reel-chrome-bottom">
          <span class="rd-reel-label">{hero.reelLabel} · {hero.reelDuration}</span>
          <span class="rd-reel-watch">
            <svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
            {hero.reelCta}
          </span>
        </div>
      </button>
    </div>
  </section>

  <!-- MARQUEE -->
  <section class="marquee-wrap" aria-label="Sectors">
    <div class="marquee">
      <div class="marquee-track">
        {marqueeLabel && <><span>{marqueeLabel}</span><span class="dot">●</span></>}
        {marquee.map((m) => (<><span>{m}</span><span class="dot">●</span></>))}
        {marqueeLabel && <><span>{marqueeLabel}</span><span class="dot">●</span></>}
        {marquee.map((m) => (<><span>{m}</span><span class="dot">●</span></>))}
      </div>
    </div>
  </section>

  <!-- WORK -->
  <section class="rd-worksec" id="work" aria-label="Selected work">
    <div class="rd-worksec-head">
      <span class="rd-sec-eyebrow">{work.eyebrow}</span>
      <h2 class="rd-worksec-title" set:html={sectionTitle(work.title)}></h2>
    </div>
    <div class="filters" role="tablist" aria-label="Filter work">
      <button class="filter is-active" data-filter="all" role="tab" aria-selected="true">All</button>
      <button class="filter" data-filter="animation" role="tab">Product Animation</button>
      <button class="filter" data-filter="stills" role="tab">Product Stills</button>
      <button class="filter" data-filter="motion" role="tab">Motion Graphics</button>
      <button class="filter" data-filter="packaging" role="tab">Packaging Design</button>
      <button class="filter" data-filter="branding" role="tab">Logo / Branding</button>
      <button class="filter" data-filter="artwork" role="tab">Artwork</button>
    </div>
    <div class="work-grid">
      {projects.map((p) => {
        const d = p.data;
        const spinAttrs = d.spinPrefix
          ? { 'data-spin-folder': d.spinFolder, 'data-spin-prefix': d.spinPrefix, 'data-spin-count': d.spinCount }
          : {};
        const videoAttr = d.video ? { 'data-video': d.video } : {};
        return (
          <a class="work-card" href="#" data-cat={d.category} data-aspect="square" {...videoAttr} {...spinAttrs}>
            <div class="work-thumb" data-swatch={d.swatch}>
              <img src={d.image} alt={`${d.title}, ${catLabels[d.category]} by Nate Winter`} loading="lazy" onerror="this.style.display='none'" />
              {d.video && <video class="work-video" muted loop playsinline preload="none" aria-label={`${d.title}, ${catLabels[d.category]} by Nate Winter`}></video>}
              <div class="work-meta">
                <h3>{d.title}</h3>
                <span class="work-cat">{catLabels[d.category]}</span>
              </div>
            </div>
          </a>
        );
      })}
    </div>
    <nav class="work-pagination" aria-label="Work pages"></nav>
  </section>

  <!-- SERVICES -->
  <section class="rd-range" id="services" aria-label="Services">
    <div class="rd-range-row">
      <div class="rd-range-head">
        <span class="rd-sec-eyebrow">{services.eyebrow}</span>
        <h2 class="rd-range-title" set:html={sectionTitle(services.title)}></h2>
      </div>
      <div class="rd-caps">
        {services.items.map((c, i) => (
          <div class="rd-cap" data-delay={(i % 4) + 1}>
            <span class="rd-cap-icon" set:html={icons[c.icon] || icons.sparkle}></span>
            <h3 class="rd-cap-title">{c.title}</h3>
            <ul class="rd-cap-desc">
              {c.desc.split(',').map((d) => <li>{d.trim()}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="rd-about" id="about" aria-label="About">
    <div class="rd-about-grid">
      <div class="rd-about-head">
        <span class="rd-sec-eyebrow">{about.eyebrow}</span>
        <h2 class="rd-about-title" set:html={sectionTitle(about.title)}></h2>
      </div>
      <div class="rd-about-photo about-portrait" data-delay="1">
        {about.portraitVideo
          ? <Fragment>
              <video class="about-src" src={about.portraitVideo} poster={about.portrait || undefined}
                     autoplay muted loop playsinline preload="auto" aria-label="Nate Winter sketching"></video>
              <canvas class="about-stopmo" aria-hidden="true"></canvas>
              <span class="about-grain" aria-hidden="true"></span>
            </Fragment>
          : (about.portrait && <img src={about.portrait} alt="Nate Winter, designer and creative director" loading="lazy" onerror="this.style.display='none'" />)}
      </div>
      <div class="rd-about-body-wrap" data-delay="1">
        <div class="rd-about-body" set:html={aboutBodyHtml}></div>
        <a href="#contact" class="rd-link-arrow rd-about-link">{about.ctaLabel}<span class="rd-arrow">→</span></a>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="rd-contact" id="contact" aria-label="Contact">
    <div class="rd-contact-grid">
      <div class="rd-contact-text">
        <span class="rd-sec-eyebrow">{contact.eyebrow}</span>
        <h2 class="rd-contact-title" set:html={sectionTitle(contact.title)}></h2>
        <p class="rd-contact-body">{contact.body}</p>
      </div>
      <form class="rd-form" data-delay="1" onsubmit="event.preventDefault();">
        <input type="text" placeholder="Your name" />
        <input type="email" placeholder="Email" />
        <input type="text" class="full" placeholder="Company (optional)" />
        <select class="full" required>
          <option value="" disabled selected hidden>Project type</option>
          {contact.projectTypes.map((t) => <option>{t}</option>)}
        </select>
        <textarea class="full" placeholder="Tell me about your project"></textarea>
        <button type="submit" class="rd-form-btn">Send message <span class="rd-arrow">→</span></button>
      </form>
    </div>
  </section>
</Base>
